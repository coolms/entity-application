{
    "name": "coolms/entity-application",
    "description": "Platform composition layer over coolms/entity: reflection field extraction, the tagged repository registry, the extras-flattening normalizer and the entity:find widget renderers",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "coolms",
        "entity",
        "extras",
        "serializer",
        "widget"
    ],
    "authors": [
        {
            "name": "Dmitry Popov"
        }
    ],
    "support": {
        "issues": "https://github.com/coolms/entity-application/issues",
        "source": "https://github.com/coolms/entity-application"
    },
    "require": {
        "php": "^8.5",
        "coolms/core": "^2.0",
        "coolms/dtmpl": "^2.0",
        "coolms/entity": "^2.0",
        "coolms/entity-persistence-implementation": "^2.0",
        "coolms/rql": "^1.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/uid": "^8.0"
    },
    "require-dev": {
        "coolms/entity-doctrine": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\Entity\\Application\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\Entity\\Application\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-develop": "2.0.x-dev"
        }
    }
}
